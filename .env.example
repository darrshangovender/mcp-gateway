# Copy to .env and replace every value. Never commit .env.

# Salt mixed into every API-key hash. Rotating it invalidates all keys.
MCP_GATEWAY_KEY_SALT=change-me-to-a-long-random-string

# Raw API keys for the two demo tenants in examples/crm_server.py.
# The server hashes these at startup; only the hashes live in memory.
CRM_ACME_KEY=change-me-acme
CRM_GLOBEX_KEY=change-me-globex

# Shared rate-limit state. Leave unset to use the in-process limiter.
MCP_GATEWAY_REDIS_URL=redis://redis:6379/0

# Where the append-only JSONL audit log is written.
MCP_GATEWAY_AUDIT_PATH=/var/lib/mcp-gateway/audit.jsonl
